# Copy to .env.development / .env.staging / .env.production
# Only public client config here — never Meta app secrets or tokens.
# Use your Mac's Bonjour name (System Settings → General → Sharing → Local hostname)
# so both the simulator and real devices on the same Wi-Fi can reach the backend.
API_BASE_URL=http://localhost:3000
API_VERSION=v1

# Supabase → Project Settings → API (URL + publishable key)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

ENABLE_LOGS=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
